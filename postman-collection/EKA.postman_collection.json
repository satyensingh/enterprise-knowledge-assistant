    {
      "name": "Ask - API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response status is successful', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test('Active token was used', function () {",
              "  pm.expect(pm.collectionVariables.get('active_token')).to.be.a('string').and.not.empty;",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test('responseId is present', function () {",
              "  pm.expect(jsonData.responseId).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('insufficientEvidence is boolean', function () {",
              "  pm.expect(jsonData.insufficientEvidence).to.be.oneOf([true, false]);",
              "});",
              "pm.collectionVariables.set('response_id', jsonData.responseId);",
              "pm.collectionVariables.set('last_insufficient_evidence', String(jsonData.insufficientEvidence));",
              "console.log('Called API using active_token_type:', pm.collectionVariables.get('active_token_type') || 'not set');",
              "console.log('Saved response_id:', jsonData.responseId);",
              "console.log('Saved last_insufficient_evidence:', jsonData.insufficientEvidence);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
