{
  "info": {
    "_postman_id": "bb97ab30-f606-4330-81d2-402273ef7535",
    "name": "EKA",
    "description": "Dynamic Postman collection for Enterprise Knowledge Assistant. Includes Keycloak token generation, assistant APIs (`health`, `ask`, `feedback`), ChromaDB heartbeat checks, admin APIs (`reindex`, evaluation endpoints), and observability APIs (`admin summary`, actuator endpoints). Prometheus checks include core RAG/ingestion metrics plus gateway additions (`kc_security_rate_limit_rejections_total`, `kc_audit_events_total`). Token requests store `user_token`/`admin_token` and set `active_token`. `Ask - API` stores `response_id` and `last_insufficient_evidence`; `Create Golden Question` stores `golden_question_id`; `Run Evaluation` stores `evaluation_run_id` for follow-up requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "44179023"
  },
  "item": [
    {
      "name": "Generate Admin Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token response is successful', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test('access_token is present', function () {",
              "  pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('admin_token', jsonData.access_token);",
              "pm.collectionVariables.set('active_token', jsonData.access_token);",
              "pm.collectionVariables.set('active_token_type', 'admin');",
              "",
              "if (jsonData.refresh_token) {",
              "  pm.collectionVariables.set('admin_refresh_token', jsonData.refresh_token);",
              "}",
              "if (jsonData.expires_in) {",
              "  const expiresAt = new Date(Date.now() + jsonData.expires_in * 1000).toISOString();",
              "  pm.collectionVariables.set('admin_token_expires_at', expiresAt);",
              "  pm.collectionVariables.set('active_token_expires_at', expiresAt);",
              "}",
              "",
              "console.log('Admin token saved into collection variables: admin_token and active_token');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{keycloak_client_id}}",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "{{keycloak_grant_type}}",
              "type": "text"
            },
            {
              "key": "username",
              "value": "{{admin_username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{admin_password}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{keycloak_protocol}}://{{keycloak_host}}:{{keycloak_port}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
          "protocol": "{{keycloak_protocol}}",
          "host": [
            "{{keycloak_host}}"
          ],
          "port": "{{keycloak_port}}",
          "path": [
            "realms",
            "{{keycloak_realm}}",
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "description": "Generates a admin Keycloak access token and saves it as `admin_token`. It also updates `active_token`, so the `/ask` requests use this token automatically."
      },
      "response": []
