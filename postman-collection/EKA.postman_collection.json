    {
      "name": "Actuator Prometheus - API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Prometheus endpoint status is successful', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('Prometheus output contains custom kc metrics', function () {",
              "  pm.expect(pm.response.text()).to.include('kc_');",
              "});",
              "",
              "const body = pm.response.text();",
              "const requiredMetrics = [",
              "  'kc_ask_requests_total',",
              "  'kc_retrieval_latency',",
              "  'kc_retrieval_chunks',",
              "  'kc_retrieval_citations',",
              "  'kc_openai_llm_latency',",
              "  'kc_ingestion_connector_sync_latency',",
              "  'kc_ingestion_documents_total',",
              "  'kc_ingestion_chunks_total',",
              "  'kc_feedback_submissions_total'",
              "];",
              "const eventDrivenMetrics = [",
              "  'kc_ask_insufficient_answers_total',",
              "  'kc_feedback_score',",
              "  'kc_security_rate_limit_rejections_total',",
              "  'kc_audit_events_total'",
              "];",
              "",
              "requiredMetrics.forEach(function(metric) {",
              "  pm.test('Contains metric: ' + metric, function () {",
              "    pm.expect(body).to.include(metric);",
              "  });",
              "});",
              "",
              "eventDrivenMetrics.forEach(function(metric) {",
              "  const present = body.includes(metric);",
              "  pm.test('Event-driven metric check: ' + metric, function () {",
              "    pm.expect(true).to.eql(true);",
              "  });",
              "  if (!present) {",
              "    console.warn('Metric not present yet (expected until trigger event): ' + metric);",
              "  }",
              "});"
            ]
          }
        }
