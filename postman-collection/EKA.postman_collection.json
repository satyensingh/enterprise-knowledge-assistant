              "  pm.expect(jsonData.inventory).to.be.an('object');",
              "  pm.expect(jsonData.ask).to.be.an('object');",
              "  pm.expect(jsonData.evaluation).to.be.an('object');",
              "  pm.expect(jsonData.security).to.be.an('object');",
              "  pm.expect(jsonData.ingestion).to.be.an('object');",
              "  pm.expect(jsonData.feedback).to.be.an('object');",
              "  pm.expect(jsonData.audit).to.be.an('object');",
              "});",
              "pm.test('Security summary exposes rate limit totals', function () {",
              "  pm.expect(jsonData.security.rateLimitRejectedTotal).to.not.equal(undefined);",
              "});",
              "pm.test('Audit summary exposes totalEvents', function () {",
